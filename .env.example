# Non-secret placeholders only. Set actual values through environment settings.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-project-publishable-key


# Required for production API abuse protection. Set only in server environment settings.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-in-host-settings
# Generate at least 32 random characters; never expose through frontend variables.
RATE_LIMIT_SECRET=replace-with-a-random-server-only-secret

# Optional cloud saving is disabled by default. Enable only after verifying live RLS/grants,
# anonymous auth, retention/privacy settings and shared production rate limiting.
TAXMETRIC_CLOUD_STORAGE_ENABLED=false
